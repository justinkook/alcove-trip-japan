{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "type", "provider", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "type": {"type": "string"},
    "provider": {"type": "string"},
    "status": {"enum": ["research", "shortlist", "hold", "confirmed", "canceled"]},
    "start": {"type": ["string", "null"]},
    "end": {"type": ["string", "null"]},
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"type": "string"}}
    },
    "exclusive": {"type": "boolean"},
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency", "commitment"],
      "properties": {
        "amount": {"type": ["number", "null"]},
        "currency": {"type": ["string", "null"]},
        "commitment": {"enum": ["estimated", "committed", "paid"]}
      }
    },
    "refundable": {"type": ["boolean", "null"]},
    "cancellation_deadline": {"type": ["string", "null"]},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "external_ref": {"type": ["string", "null"]}
  }
}
